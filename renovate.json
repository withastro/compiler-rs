{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Group all dependencies from the biomejs/biome repo (cargo crates + @biomejs/* npm packages)",
      "matchDepNames": ["biome_*", "@biomejs/*"],
      "groupName": "biome",
      "groupSlug": "biome"
    },
    {
      "description": "Group all dependencies from the withastro/oxc fork",
      "matchDepNames": ["oxc_*", "!oxc_sourcemap"],
      "groupName": "oxc fork",
      "groupSlug": "oxc-fork"
    },
    {
      "description": "Group all remaining JS dependencies together",
      "matchManagers": ["npm"],
      "matchDepNames": ["!@biomejs/*"],
      "groupName": "js deps",
      "groupSlug": "js-deps"
    },
    {
      "description": "Group all non-major GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    }
  ]
}
