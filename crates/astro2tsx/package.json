{
  "name": "@astrojs/astro2tsx",
  "version": "0.1.0",
  "private": true,
  "description": "Convert .astro files to TSX for tsserver intellisense",
  "keywords": [
    "astro",
    "tsx",
    "intellisense",
    "language-server"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "files": [
    "astro2tsx.wasm32-wasi.wasm",
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "build": "napi build --platform --no-js --target wasm32-wasip1-threads --release",
    "build-dev": "napi build --platform --no-js --target wasm32-wasip1-threads",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test ./__test__/*.test.ts",
    "version": "napi version"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "1.1.1"
  },
  "devDependencies": {
    "@emnapi/runtime": "1.8.1",
    "@napi-rs/cli": "^3",
    "@types/node": "^22",
    "typescript": "~5.5.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "astro2tsx",
    "packageName": "@astrojs/astro2tsx"
  }
}
